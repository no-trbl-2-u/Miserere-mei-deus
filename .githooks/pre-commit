#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# The telemetry/ shards are generated residue, but they belong to the code
# change that produced them. Always stage their current state (including a
# session's brand-new shard) with any commit. One file per session, so this
# never stages a file another branch also writes.
if [ -n "$(git status --porcelain -- telemetry/)" ]; then
  git add -A -- telemetry/
  printf '%s\n' 'pre-commit: staged telemetry/ alongside this commit.' >&2
fi

# Retired terminology is cheapest to reject before it reaches a hosted runner.
# Active package workflows run the same check remotely; this hook protects
# documentation-only commits between the weekly remote backstops.
if git diff --cached --name-only --diff-filter=ACMR \
  | grep -Eq '(\.md$|^axiomancer-mechanics/docs/lexicon\.json$|^scripts/check-lexicon\.mjs$)'; then
  node scripts/check-lexicon.mjs
fi

# The same argument for authored `.ts` prose (phase 70): the house-voice rules
# are cheapest to apply while the writer is still holding the sentence.
if git diff --cached --name-only --diff-filter=ACMR \
  | grep -Eq '(^axiomancer-mechanics/src/(World|Enemy|Cards)/.*\.ts$|\.copy\.ts$|^scripts/check-prose\.mjs$)'; then
  node scripts/check-prose.mjs
fi

# Cloudflare Pages serves whatever `main`'s tree contains. The DevLog's
# generated HTML/data/art must never re-enter the index — check it whenever
# a staged change touches devlog/ (phase 57).
if git diff --cached --name-only --diff-filter=ACMR \
  | grep -q '^devlog/'; then
  node scripts/check-devlog-not-served.mjs
fi

# The lessons ladder and T's moves are linted in root `npm test`, which no
# local workspace gate runs, so an over-long row reached a PR twice. Lint them
# whenever one is staged, however it was edited.
if git diff --cached --name-only --diff-filter=ACMR \
  | grep -Eq '^(plan/(lessons|reflexes|NEEDS_T)\.md|scripts/check-lessons\.mjs)$'; then
  node scripts/check-lessons.mjs
fi
