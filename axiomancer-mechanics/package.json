{
  "name": "axiomancer-mechanics",
  "version": "0.37.0",
  "description": "Turn-based RPG combat mechanics with philosophical themes",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "check": "npm run lint && npm run type-check",
    "clean": "rm -rf dist",
    "game": "ts-node src/CLI/game.cli.ts",
    "hazard": "ts-node src/CLI/game.cli.ts hazard",
    "combat": "ts-node src/CLI/game.cli.ts combat",
    "labyrinth": "ts-node src/CLI/game.cli.ts labyrinth",
    "combat-sim": "ts-node src/CLI/combat-sim.cli.ts",
    "act1-progression": "ts-node src/CLI/act1-progression.cli.ts",
    "measured-truth": "ts-node src/CLI/measured-truth.cli.ts",
    "combat-playtest": "ts-node src/CLI/combat-playtest.cli.ts",
    "lane-pacing": "ts-node --transpile-only src/CLI/lane-pacing.cli.ts",
    "perf-bench": "ts-node src/CLI/perf-bench.cli.ts",
    "agent-e2e": "node automation/agent-e2e.mjs",
    "catalog:export": "ts-node --transpile-only scripts/export-catalog.ts",
    "dev": "echo Please use check 'package.json' or README.md for available commands...\n ",
    "lint:fix": "eslint \"**/*.ts\" --fix",
    "lint": "eslint \"**/*.ts\"",
    "start": "echo Please use check 'package.json' or README.md for available commands...\n ",
    "test:watch": "vitest",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "type-check:tests": "tsc -p tsconfig.tests.json",
    "type-check:cli": "tsc -p tsconfig.cli.json",
    "verify": "npm run type-check && npm run type-check:tests && npm run type-check:cli && npm run lint && npm test && npm run build",
    "verify:agent": "npm run type-check && npm run type-check:tests && npm run type-check:cli && npm run lint && vitest run --reporter=default --reporter=./automation/agent-vitest-reporter.mjs && npm run build",
    "roster-health": "ts-node src/CLI/roster-health.cli.ts",
    "act1-walk": "ts-node --transpile-only src/CLI/act1-walk.cli.ts",
    "puzzle:report": "ts-node --transpile-only src/CLI/puzzle-report.cli.ts",
    "puzzle:audit": "ts-node --transpile-only src/CLI/puzzle-audit.cli.ts"
  },
  "keywords": [
    "rpg",
    "combat",
    "mechanics",
    "turn-based"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "eslint": "^9.39.1",
    "globals": "^17.7.0",
    "inquirer": "^12.11.1",
    "jiti": "^2.6.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "eslint-plugin-typescript": "^0.14.0",
    "zustand": "^5.0.14"
  }
}
