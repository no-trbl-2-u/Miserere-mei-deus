{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "env": {
        "EXPO_PUBLIC_PLAY_LOG_SOURCE": "human"
      },
      "android": {
        "buildType": "apk",
        "distribution": "internal"
      }
    },
    "beta": {
      "ios": {
        "distribution": "store",
        "autoIncrement": "buildNumber"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_PLAY_LOG_SOURCE": "human"
      },
      "ios": {
        "distribution": "store",
        "autoIncrement": "buildNumber"
      },
      "android": {
        "distribution": "internal",
        "autoIncrement": "versionCode",
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "beta": {
      "ios": {
        "ascAppId": "IO1B_FILLS_THE_APP_STORE_CONNECT_APP_ID"
      }
    }
  }
}
