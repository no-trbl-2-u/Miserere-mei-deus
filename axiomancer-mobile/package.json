{
  "name": "axiomancer-mobile",
  "main": "index.ts",
  "version": "1.9.0",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "_engineNotes": "Dev container (scripts/dev-server-container.sh) uses node:22-alpine for consistency with CI (all verify-* workflows and _claude-skill.yml pin Node 22). Local dev accepts any Node >=22.0.0.",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:container": "./scripts/dev-server-container.sh up",
    "web:container:wait": "./scripts/dev-server-container.sh wait",
    "web:container:down": "./scripts/dev-server-container.sh down",
    "lint": "eslint app components",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "verify": "npm run lint && npm run typecheck && npm test && npm run assets:check && npm run art:test && npm run critique-drive:test && npm run smoke:test && npm run feature-map-drive:test",
    "verify:visual": "node scripts/smoke-screens.mjs",
    "e2e:hazard": "node scripts/hazard-e2e.mjs",
    "e2e:combat": "node scripts/combat-round-e2e.mjs",
    "e2e:encounters": "node scripts/encounter-routing-e2e.mjs",
    "e2e:theme": "node scripts/theme-switch-e2e.mjs",
    "e2e:exploration-roundtrip": "node scripts/exploration-combat-roundtrip-e2e.mjs",
    "e2e:labyrinth-roundtrip": "node scripts/labyrinth-combat-roundtrip-e2e.mjs",
    "e2e:map-walk": "node scripts/map-walk-e2e.mjs",
    "e2e:act1-walk": "node scripts/act1-walk-e2e.mjs",
    "e2e:feature-map": "node scripts/feature-map-e2e.mjs",
    "e2e:combat-round": "node scripts/combat-round-e2e.mjs",
    "e2e:combat-round:boss": "ENCOUNTER_KIND=boss PRESET=sage node scripts/combat-round-e2e.mjs",
    "e2e:combat-round:withdraw": "WITHDRAW=1 node scripts/combat-round-e2e.mjs",
    "e2e:combat-round:levelup": "LEVEL_UP=1 PRESET=sage node scripts/combat-round-e2e.mjs",
    "e2e:fixture": "node scripts/fixture-e2e.mjs",
    "critique:drive": "node scripts/critique-drive.mjs",
    "perf:combat-drag": "node scripts/combat-drag-perf.mjs",
    "e2e:minigames": "node scripts/hazard-e2e.mjs && node scripts/encounter-routing-e2e.mjs && node scripts/exploration-combat-roundtrip-e2e.mjs && node scripts/combat-round-e2e.mjs",
    "smoke:bundler": "node scripts/smoke-bundler.mjs",
    "baseline:approve": "node scripts/baseline-approve.mjs",
    "deploy:check": "node scripts/deploy-check.mjs",
    "deploy": "npm run deploy:preview",
    "deploy:preview": "npm run verify && node scripts/with-env.mjs eas build --platform android --profile preview",
    "deploy:production": "npm run verify && node scripts/with-env.mjs eas build --platform all --profile production",
    "assets:check": "node --test scripts/asset-provenance.test.mjs scripts/potential-assets-sealed.test.mjs scripts/frame-cells.test.mjs",
    "assets:ingest": "node scripts/ingest-art.mjs",
    "art:gen": "node scripts/generate-art.mjs",
    "art:qa": "node scripts/art/qa.mjs",
    "art:test": "node --test scripts/art.test.mjs scripts/art-sheet.test.mjs scripts/shrink-art.test.mjs scripts/title-plate-legibility.test.mjs",
    "art:legibility": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/title-plate-legibility.mjs",
    "critique-drive:test": "node --test scripts/critique-drive.test.mjs",
    "feature-map-drive:test": "node --test scripts/feature-map-drive.test.mjs",
    "smoke:test": "node --test scripts/smoke-screens.test.mjs scripts/web-export.test.mjs scripts/smoke-routes-for.test.mjs",
    "assets:acquire": "node scripts/acquire-art.mjs",
    "eas-build-on-success": "node scripts/sentry-release.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "@sentry/react-native": "~7.2.0",
    "dotenv": "^17.4.2",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-navigation-bar": "~5.0.10",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.49.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4",
    "typescript": "~5.9.2"
  },
  "private": true
}
