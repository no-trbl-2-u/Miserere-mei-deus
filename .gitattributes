# Merge plan/lessons.md and plan/NEEDS_T.md by slug, not by line (Phase ML1a):
# scripts/lessons-merge.mjs, registered as merge.lessons.driver by the
# SessionStart hook in .claude/settings.json. Unregistered (a fresh clone
# before any Claude session, a CI runner) git falls back to its line merge.
plan/lessons.md merge=lessons
plan/NEEDS_T.md merge=lessons

# Merge plan/steps/01_build_plan.md with same-spot insertions unioned (Phase
# ML1b): scripts/build-plan-merge.mjs, registered as merge.buildplan.driver the
# same way. Unregistered, git falls back to its line merge.
plan/steps/01_build_plan.md merge=buildplan

# Merge plan/deadlines.md with same-spot insertions unioned and a row both
# sides edited merged cell by cell (Phase MD1a): scripts/deadlines-merge.mjs,
# registered as merge.deadlines.driver the same way. Unregistered, git falls
# back to its line merge.
plan/deadlines.md merge=deadlines

# The art-department masters are compared byte for byte against a fresh
# regeneration (art-department/tests/test_rig_spritesheet.py), so git must
# never rewrite their line endings on checkout.
art-department/masters/** -text
